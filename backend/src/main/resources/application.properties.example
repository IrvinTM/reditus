spring.application.name=reditus
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver
#--------------------------------------
# Show or not log for each sql query
spring.jpa.show-sql=true
# The schema is managed by Flyway migrations in src/main/resources/db/migration.
# Hibernate only checks that the entities match it.
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
# databases created before Flyway was adopted are taken as V1 (see V1__baseline.sql)
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

app.security.username=${APP_SECURITY_USERNAME:admin}
app.security.password=${APP_SECURITY_PASSWORD:admin123}
app.security.seed-default-user=${APP_SECURITY_SEED_DEFAULT_USER:true}

app.security.jwt-secret=${JWT_SECRET}
app.security.jwt-expiration-ms=${JWT_EXPIRATION_MS:86400000}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000}

# Database backups (pg_dump / pg_restore must be installed, same or newer major version than the server).
# Point the folder to a USB drive or a cloud-synced folder to keep a copy outside this machine.
app.backup.dir=${BACKUP_DIR:backups}
app.backup.cron=${BACKUP_CRON:0 0 2 * * *}
app.backup.keep=${BACKUP_KEEP:14}
app.backup.pg-dump=${PG_DUMP_PATH:pg_dump}
app.backup.pg-restore=${PG_RESTORE_PATH:pg_restore}
spring.servlet.multipart.max-file-size=2GB
spring.servlet.multipart.max-request-size=2GB
